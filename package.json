{
  "name": "@local/dsh-monokai-pro",
  "version": "1.1.0",
  "type": "module",
  "description": "Monokai Pro inspired dark theme for the Harness Web UI: palette, accents, syntax colors, typography and a General settings switch.",
  "homepage": "https://github.com/yourusername/dsh-monokai-pro",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/dsh-monokai-pro.git"
  },
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  }
}