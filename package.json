{
  "name": "dsh-monokai-pro",
  "version": "1.1.0",
  "type": "module",
  "description": "Monokai Pro dark theme for the DeepSeek Harness Web GUI — six official filters, syntax highlighting, and a General settings switch.",
  "homepage": "https://github.com/trespassmk/dsh-monokai-pro",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trespassmk/dsh-monokai-pro.git"
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "theme",
    "monokai-pro",
    "monokai"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-theme",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  }
}